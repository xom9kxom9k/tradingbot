# Copy to .env and fill in. Never commit .env.

# --- Telegram ---
# Token issued by @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Comma-separated whitelist of chat ids allowed to talk to the bot
TELEGRAM_CHAT_IDS=111111111,222222222
TELEGRAM_ENABLED=true

# --- Runtime overrides (optional) ---
# Any config key can be overridden with the TRADINGBOT_ prefix and __ as nesting separator,
# e.g. TRADINGBOT_EXCHANGE__TIMEFRAME=1h
# TRADINGBOT_LOGGING__LEVEL=DEBUG
